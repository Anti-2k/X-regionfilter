{
  "manifest_version": 3,
  "name": "Regionfilter for X",
  "short_name": "Regionfilter",
  "version": "3.0.0",
  "description": "Unlists tweets whose author is based in a country or region you don't want to see. Nothing is blocked — direct links still work.",
  "browser_specific_settings": {
    "gecko": {
      "id": "regionfilter@tbr.local",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ],
        "optional": [
          "websiteContent"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://x.com/*",
    "*://*.x.com/*",
    "*://twitter.com/*",
    "*://*.twitter.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": [
      "src/regions.js",
      "src/settings.js",
      "src/matcher.js",
      "src/background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://x.com/*",
        "*://mobile.x.com/*",
        "*://twitter.com/*",
        "*://mobile.twitter.com/*"
      ],
      "js": [
        "src/regions.js",
        "src/settings.js",
        "src/matcher.js",
        "src/content.js"
      ],
      "css": [
        "src/styles.css"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "*://x.com/*",
        "*://mobile.x.com/*",
        "*://twitter.com/*",
        "*://mobile.twitter.com/*"
      ],
      "js": [
        "src/page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "ui/options.html",
    "open_in_tab": true
  },
  "action": {
    "default_popup": "ui/popup.html",
    "default_title": "Regionfilter",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "96": "icons/icon-96.png",
    "128": "icons/icon-128.png"
  }
}
